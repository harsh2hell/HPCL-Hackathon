# Database Configuration (SQLite for local dev, Postgres compatible)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Required for Phase 2/3: RAG, Embeddings, Triage)
# If missing, the app gracefully falls back to offline keyword search and rule-based heuristics.
GEMINI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
